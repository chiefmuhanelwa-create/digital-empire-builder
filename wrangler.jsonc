{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "chkplt.com/*", "zone_name": "chkplt.com" },
    // Phase 2A, 2026-07-28: Starter Kit/Foundation Kit/Accelerator moved fully
    // onto contentpreneur.africa (chkplt.com removed from that customer
    // journey entirely, per founder instruction). These are path-specific, not
    // a catch-all — contentpreneur.africa's own Next.js site (a separate
    // Worker) still owns the homepage/about via its own "contentpreneur.africa/*"
    // route; Cloudflare resolves the more specific pattern below to THIS Worker
    // for these 4 paths only. /apply is included because the Accelerator's CTA
    // links to it — without this route it would 404 under this domain.
    { "pattern": "contentpreneur.africa/starterkit*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/foundation*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/accelerator*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/apply*", "zone_name": "contentpreneur.africa" },
    // Creator Bundle landing page added 2026-08-06 — same family as the 4
    // routes above, needs the same explicit path-specific entry or it 522s
    // (falls through to the Next.js site's Worker, which has no such route).
    { "pattern": "contentpreneur.africa/creator-bundle*", "zone_name": "contentpreneur.africa" },
    // 2026-08-19 — landing page for the Instagram keyword "rent" (the River,
    // Fish, Tank video). Needs its own route entry or it 522s, same as every
    // other path-specific page on this zone.
    { "pattern": "contentpreneur.africa/rented*", "zone_name": "contentpreneur.africa" },
    // Phase 3, 2026-08-18 — THE MEMBER WORKSPACE MOVES HERE. Founder ruling:
    // the Foundation Kit workspace lives under contentpreneur.africa, not
    // chkplt.com. Before this, /foundation sold on this domain but
    // /dashboard/foundation-kit only existed on chkplt.com — verified live:
    // contentpreneur.africa/dashboard/foundation-kit HUNG (no Worker owned it,
    // the Next.js site's routes were narrowed to /, /about*, /_next/* on
    // 2026-08-02) and contentpreneur.africa/login 404'd. So every kit buyer was
    // handed to a second brand the moment they tried to open what they bought.
    //
    // /login, /signup, /reset-password and /account come along because a
    // workspace you cannot sign in to is not a workspace. /admin comes along
    // because it shares the same login — leaving it behind would strand admin
    // on a domain whose /login now 301s away (see src/server.ts).
    //
    // The storefront (/products, /cart, /search, /tools) deliberately does NOT
    // move: it is CHKPLT-branded and its header links across the whole
    // catalogue. Member-area links to it are absolute — see src/lib/domains.ts.
    { "pattern": "contentpreneur.africa/dashboard*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/apps/*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/learn*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/account*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/login*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/signup*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/reset-password*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/admin*", "zone_name": "contentpreneur.africa" },
    // Bug found 2026-07-28 (live, via a real screenshot): the 4 page routes
    // above load fine, but their CSS/JS bundles are requested from bare
    // "/assets/*" and "/downloads/*" paths — those don't match any pattern
    // above, so they fell through to the Next.js site's "contentpreneur.africa/*"
    // catch-all instead, which 404'd them (confirmed via response headers:
    // x-nextjs-cache/x-opennext). Result: completely unstyled pages. This app's
    // own static asset convention is "/assets/*" (Vite), which doesn't collide
    // with the Next.js site's "/_next/static/*" convention, so this is safe to add.
    { "pattern": "contentpreneur.africa/assets/*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/downloads/*", "zone_name": "contentpreneur.africa" },
    // Same bug as above, found 2026-08-08: starterkit/creator-bundle's product
    // cover images live under "/product-covers/*", also uncaught by any pattern.
    { "pattern": "contentpreneur.africa/product-covers/*", "zone_name": "contentpreneur.africa" },
    // Phase 2C, 2026-07-28: checkout.functions.ts builds the post-payment
    // redirect from the ACTUAL request host (getRequestHost()) — so a purchase
    // started on contentpreneur.africa/foundation redirects back to
    // "contentpreneur.africa/checkout/success", not chkplt.com. Without this
    // route that would 404 immediately after every successful purchase. This is
    // part of the sales transaction itself (not ongoing account management),
    // so it stays on this domain regardless of the founder's decision to leave
    // post-purchase dashboard/login on chkplt.com.
    { "pattern": "contentpreneur.africa/checkout*", "zone_name": "contentpreneur.africa" },
    // Same routing gap, caught proactively this time instead of via another
    // screenshot: ContentpreneurFooter (used on starterkit/foundation/
    // accelerator) links to /contact, /terms, /privacy, /refund-policy —
    // real CHKPLT pages, kept CHKPLT-branded on purpose (they describe the
    // actual platform processing the payment), but still need routing here
    // or a hard refresh/direct link/new-tab open on these paths 404s.
    { "pattern": "contentpreneur.africa/contact*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/terms*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/privacy*", "zone_name": "contentpreneur.africa" },
    { "pattern": "contentpreneur.africa/refund-policy*", "zone_name": "contentpreneur.africa" },
    // Bug found 2026-08-02: every form on this domain (starterkit, apply, etc.)
    // hung forever on "Sending..." — TanStack Start's server functions (the
    // actual mutation call behind every form submit) POST to "/_serverFn/*"
    // by default, a path never added to this route list. It doesn't collide
    // with any page path above so it was harmless while the old Next.js site's
    // wildcard silently swallowed it; once that wildcard was narrowed (see
    // contentpreneur-africa-site/wrangler.jsonc, same date) it matched nothing
    // on either Worker at all, causing the hang instead of a 404.
    { "pattern": "contentpreneur.africa/_serverFn/*", "zone_name": "contentpreneur.africa" }
  ],
  "triggers": {
    // "* * * * *" every minute → drain the transactional/auth email queue (Resend).
    //
    // The daily "10 4 * * *" FX job is DELIBERATELY REMOVED (2026-08-14).
    // It rewrote every product's price_cents each morning to track a fixed USD
    // price at the live rand rate, so displayed ZAR prices moved on their own —
    // sars-creator-income was observed changing from R145.61 to R145.21 inside a
    // single day. Prices are now whatever is set in the products table and stay
    // there until a human changes them. See src/lib/fx-sync.ts.
    "crons": ["* * * * *"]
  }
}
